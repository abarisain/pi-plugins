    "index.ts",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "omp",
    "oh-my-pi",
    "telegram",
    "notifications"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abarisain/pi-plugins.git",
    "directory": "plugins/pi-silent-turn"
  },
  "homepage": "https://github.com/abarisain/pi-plugins/tree/master/plugins/pi-silent-turn",
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
